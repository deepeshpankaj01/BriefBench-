# ==============================================================================
# BriefBench Environment Configuration
# ==============================================================================

# Database: Local SQLite (file:./dev.db) or Neon / PostgreSQL
DATABASE_URL="file:./dev.db"
# Example Neon PostgreSQL connection string:
# DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/briefbench?sslmode=require"

# Bifrost Gateway (by Maxim AI) Configuration
# The unified LLM gateway endpoint, API key, and selected model
BIFROST_API_KEY=""
BIFROST_BASE_URL="https://api.bifrost.maxim.ai/v1"
BIFROST_MODEL="gpt-4o"
BIFROST_FALLBACK_MODEL="claude-3-5-sonnet"

# Tavily Meeting Research Integration
# Official API key from https://app.tavily.com
TAVILY_API_KEY=""

# LangGraph Python Microservice URL
LANGGRAPH_AGENT_URL="http://127.0.0.1:8000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
AUTH_SECRET="briefbench_hackathon_super_secret_session_key_2026"
