# ==============================================================================
# BriefBench Environment Configuration (Vercel Multi-Service Deployment)
# ==============================================================================

# Database: Production PostgreSQL (Neon Serverless Postgres, Supabase, RDS)
DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/briefbench?sslmode=require"

# Tavily AI Search & Extract
TAVILY_API_KEY=""

# Maxim AI Bifrost LLM Gateway
BIFROST_API_KEY=""
BIFROST_BASE_URL="https://api.bifrost.maxim.ai/v1"
BIFROST_MODEL="gpt-4o"

# Application & Session Settings
AUTH_SECRET=""
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_APP_URL="https://your-briefbench-domain.vercel.app"

# NOTE: LANGGRAPH_AGENT_URL is NOT set manually here.
# Vercel Multi-Service automatically injects LANGGRAPH_AGENT_URL via service binding in vercel.json.
