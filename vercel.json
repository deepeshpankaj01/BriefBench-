{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "langgraph-agent",
          "format": "url",
          "env": "LANGGRAPH_AGENT_URL"
        }
      ]
    },
    "langgraph-agent": {
      "root": "apps/langgraph-agent",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
