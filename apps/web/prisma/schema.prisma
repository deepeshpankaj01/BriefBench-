// Production PostgreSQL Schema for BriefBench Vercel Deployment
// Compatible with Neon Serverless Postgres, Supabase, AWS RDS, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("ENGINEER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents          Agent[]
  suites          BenchmarkSuite[]
  experiments     BenchmarkExperiment[]
  integrations    IntegrationConnection[]
  auditEvents     AuditEvent[]
}

model Agent {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  slug          String
  framework     String   // NATIVE_TS, LANGGRAPH_PYTHON, HTTP_CUSTOM
  description   String?  @db.Text
  endpointUrl   String?
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions      AgentVersion[]
  runs          AgentRun[]

  @@unique([workspaceId, slug])
}

model AgentVersion {
  id              String   @id @default(cuid())
  agentId         String
  version         String   // e.g. "1.0.0"
  configHash      String
  model           String
  systemPrompt    String   @db.Text
  toolDefinitions String   @db.Text
  parameters      String   @db.Text
  createdAt       DateTime @default(now())

  agent           Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs            AgentRun[]
}

model BenchmarkSuite {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?  @db.Text
  category    String   @default("MEETING_RESEARCH")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       BenchmarkTask[]
}

model BenchmarkTask {
  id                String   @id @default(cuid())
  suiteId           String
  title             String
  objective         String   @db.Text
  companyName       String?
  meetingContext    String   @db.Text
  requirements      String   @db.Text
  expectedCitations String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  suite             BenchmarkSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  snapshots         EvidenceSnapshot[]
  experiments       BenchmarkExperiment[]
}

model EvidenceSnapshot {
  id            String   @id @default(cuid())
  taskId        String
  digest        String   // SHA-256
  title         String
  description   String?  @db.Text
  isFrozen      Boolean  @default(true)
  version       Int      @default(1)
  totalSources  Int      @default(0)
  createdAt     DateTime @default(now())

  task          BenchmarkTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sources       EvidenceSource[]
  experiments   BenchmarkExperiment[]
}

model EvidenceSource {
  id                 String   @id @default(cuid())
  snapshotId         String
  url                String
  title              String
  excerpt            String   @db.Text
  fullContent        String   @db.Text
  domain             String
  publishedAt        String?
  retrievalTimestamp DateTime @default(now())
  metadata           String?  @db.Text

  snapshot           EvidenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model BenchmarkExperiment {
  id                 String    @id @default(cuid())
  workspaceId        String
  taskId             String
  snapshotId         String
  name               String
  repetitions        Int       @default(3)
  concurrencyLimit   Int       @default(1)
  status             String    @default("PENDING")
  faultProfileId     String?
  isDemo             Boolean   @default(false)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task               BenchmarkTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  snapshot           EvidenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  faultProfile       FaultProfile?    @relation(fields: [faultProfileId], references: [id])
  runs               AgentRun[]
}

model AgentRun {
  id                 String    @id @default(cuid())
  experimentId       String
  agentId            String
  agentVersionId     String
  repetitionIndex    Int       @default(1)
  status             String    @default("PENDING")
  durationMs         Int?
  totalTokens        Int?
  promptTokens       Int?
  completionTokens   Int?
  estimatedCostUsd   Float?
  toolCallCount      Int       @default(0)
  retryCount         Int       @default(0)
  outputReport       String?   @db.Text
  errorMessage       String?   @db.Text
  isDemo             Boolean   @default(false)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  experiment         BenchmarkExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  agent              Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion       AgentVersion        @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  traceEvents        TraceEvent[]
  toolCalls          ToolCall[]
  evaluation         Evaluation?
}

model TraceEvent {
  id            String   @id @default(cuid())
  runId         String
  stepNumber    Int
  eventType     String
  name          String
  inputPayload  String?  @db.Text
  outputPayload String?  @db.Text
  durationMs    Int?
  tokenUsage    Int?
  status        String   @default("SUCCESS")
  errorDetails  String?  @db.Text
  timestamp     DateTime @default(now())

  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ToolCall {
  id              String   @id @default(cuid())
  runId           String
  toolName        String
  arguments       String   @db.Text
  result          String?  @db.Text
  isFaultInjected Boolean  @default(false)
  durationMs      Int?
  createdAt       DateTime @default(now())

  run             AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Evaluation {
  id                    String   @id @default(cuid())
  runId                 String   @unique
  judgeModel            String   @default("bifrost/gpt-4o")
  rubricVersion         String   @default("1.0.0")
  overallScore          Float
  factualAccuracy       Float
  evidenceSupport       Float
  taskCompletion        Float
  researchCompleteness  Float
  actionability         Float
  instructionAdherence  Float
  outputConsistency     Float
  reasoning             String   @db.Text
  unsupportedClaims     String   @db.Text
  verifiedCitations     String   @db.Text
  createdAt             DateTime @default(now())

  run                   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model FaultProfile {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String   @db.Text
  faultType        String
  triggerStep      String
  triggerCondition String?  @db.Text
  isSimulated      Boolean  @default(true)
  failureRate      Float    @default(1.0)
  createdAt        DateTime @default(now())

  experiments      BenchmarkExperiment[]
}

model IntegrationConnection {
  id                String    @id @default(cuid())
  workspaceId       String
  provider          String
  status            String    @default("CONNECTED")
  endpointUrl       String?
  model             String?
  lastHealthCheckAt DateTime?
  lastErrorMessage  String?   @db.Text
  telemetry         String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  action      String
  entityType  String
  entityId    String
  details     String?  @db.Text
  actorEmail  String   @default("system@briefbench.ai")
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
